<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Info -->
    <PackageId>CodeAnalysis.Mcp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Your Name</Authors>
    <Description>MCP server for analyzing .NET codebases to find unreferenced code using Roslyn</Description>
    <PackageTags>mcp;roslyn;code-analysis;dotnet;unreferenced-code</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/yourusername/CodeAnalysisMCP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yourusername/CodeAnalysisMCP</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- .NET Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>code-analysis-mcp</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="0.4.0-preview.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeAnalysis.Core\CodeAnalysis.Core.csproj" />
  </ItemGroup>

</Project>
